@model ReviewPageModel
<link rel="stylesheet" href="~/_content/QuestionAppBuilder.Core/css/runtime.css" />
<main class="qab-runtime qab-review" data-response-id="@Model.Response.Id">
    <p class="qab-eyebrow">Review</p>
    <h1>Review your answers</h1>
    @if (!Model.Response.AcceptingSubmissions)
    {
        <p class="qab-error-summary" role="status">Submissions are currently closed. Your saved response remains available, and you can submit when submissions reopen.</p>
    }
    @if (Model.SummaryMessage is not null || (Model.FieldErrors?.Count ?? 0) > 0) { @await Html.PartialAsync("_ErrorSummary", Model) }
    @if (!Model.Questionnaire.HideReviewSummary && !string.IsNullOrWhiteSpace(Model.Questionnaire.ReviewSummary)) { <p class="qab-review-summary">@Model.Questionnaire.ReviewSummary</p> }
    @foreach (var category in Model.Questionnaire.Categories)
    {
        <section class="qab-review-category"><h2>@category.Name</h2>
            @foreach (var element in category.Elements.Where(e => !e.IsHidden))
            {
                if (element.Question is null)
                {
                    @await Html.PartialAsync("~/Areas/QuestionAppBuilderCore/Views/Shared/_RenderElement.cshtml", element)
                    continue;
                }
                var question = element.Question!;
                var answer = question.Value;
                var shownValue = answer?.Text ?? answer?.Number?.ToString(System.Globalization.CultureInfo.InvariantCulture);
                if (question.AnswerType is QuestionAppBuilder.Domain.Enums.AnswerType.Dropdown or QuestionAppBuilder.Domain.Enums.AnswerType.RadioGroup or QuestionAppBuilder.Domain.Enums.AnswerType.Checkboxes)
                {
                    shownValue = string.Join(", ", question.Options.Where(option => answer?.SelectedOptionIds?.Contains(option.Id) == true).Select(option => option.Label));
                }
                if (question.AnswerType == QuestionAppBuilder.Domain.Enums.AnswerType.Date) shownValue = question.DateDisplayValue;
                if (string.IsNullOrWhiteSpace(shownValue)) shownValue = "Not answered";
                @if (element.FollowUpContext is not null) { <p class="qab-follow-up-context">Follow-up: @element.FollowUpContext</p> }
                <dl><dt id="question-@question.Id">@question.Label</dt><dd>@if (question.AnswerType == QuestionAppBuilder.Domain.Enums.AnswerType.UploadDocument && answer?.Text is not null) { <a href="@(ViewData["DocumentUrl"])?questionId=@question.Id">@shownValue</a> } else { @shownValue }</dd></dl>
            }
            @await Html.PartialAsync("~/Areas/QuestionAppBuilderCore/Views/Shared/_CalculatedValues.cshtml", category.CalculatedValues)
            <a class="qab-button qab-button-secondary" href="@($"{ViewData["EditCategoryUrlPrefix"]}{category.Index}")">Edit @category.Name</a>
        </section>
    }
    <form method="post" action="@ViewData["SubmitUrl"]" data-runtime-form>
        @Html.AntiForgeryToken()
        <input type="hidden" name="ExpectedRevision" value="@Model.ExpectedRevision" />
        <input type="hidden" name="RequestId" value="@Model.RequestId" />
        @foreach (var answer in Model.Response.Answers)
        {
            if (answer.Value.Text is not null) { <input type="hidden" name="Answers[@answer.Key].Text" value="@answer.Value.Text" /> }
            if (answer.Value.Number is not null) { <input type="hidden" name="Answers[@answer.Key].Number" value="@answer.Value.Number.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" /> }
            foreach (var optionId in answer.Value.SelectedOptionIds ?? Array.Empty<int>()) { <input type="hidden" name="Answers[@answer.Key].SelectedOptionIds" value="@optionId" /> }
        }
        <div class="qab-action-bar"><a class="qab-button qab-button-secondary" href="@ViewData["EditUrl"]">Back to answers</a>
            <button class="qab-button qab-button-primary" type="submit" disabled="@(!Model.Response.AcceptingSubmissions)">@Model.Questionnaire.SubmitLabel</button></div>
    </form>
</main>
