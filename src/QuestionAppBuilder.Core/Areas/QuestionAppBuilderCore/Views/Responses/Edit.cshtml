@model ResponsePageModel
<link rel="stylesheet" href="~/_content/QuestionAppBuilder.Core/css/runtime.css" />
<script src="~/_content/QuestionAppBuilder.Core/js/runtime.js" defer></script>
<main class="qab-runtime" data-response-id="@Model.Response.Id" data-save-url="@ViewData["SaveUrl"]" data-save-delay="600">
    <header class="qab-header">
        <p class="qab-eyebrow">@(Model.Questionnaire.Preview ? "Preview" : "Questionnaire")</p>
        <h1>@Model.Questionnaire.Title</h1>
        <p class="qab-save-status" role="status" aria-live="polite">@(Model.SaveStatus ?? "Your answers save as you go.")</p>
    </header>
    @if (Model.SummaryMessage is not null || (Model.FieldErrors?.Count ?? 0) > 0) { @await Html.PartialAsync("_ErrorSummary", Model) }
    <form method="post" action="@ViewData["NavigateUrl"]" class="qab-form" data-runtime-form>
        @Html.AntiForgeryToken()
        <input type="hidden" name="ExpectedRevision" value="@Model.ExpectedRevision" />
        <input type="hidden" name="CurrentCategoryIndex" value="@Model.CurrentCategoryIndex" />
        <div data-live-content>@await Html.PartialAsync("_LiveContent", Model)</div>
        <div class="qab-action-bar">
            @if (Model.CurrentCategoryIndex > 0)
            {
                <button class="qab-button qab-button-secondary" type="submit" name="TargetCategoryIndex" value="@(Model.CurrentCategoryIndex - 1)">Back</button>
            }
            @if (Model.CurrentCategoryIndex < Model.Questionnaire.Categories.Count - 1)
            {
                <button class="qab-button qab-button-primary" type="submit" name="TargetCategoryIndex" value="@(Model.CurrentCategoryIndex + 1)">Save &amp; Continue</button>
            }
            else
            {
                <button class="qab-button qab-button-primary" type="submit" name="Intent" value="Review">Review your answers</button>
            }
        </div>
    </form>
    <p class="qab-footer-note">You can leave and return to this response from the same account or access link.</p>
</main>
