@model ResponsePageModel
@{ ViewData["FieldErrors"] = Model.FieldErrors; ViewData["InputValues"] = Model.InputValues; }
<input type="hidden" name="CurrentCategoryIndex" value="@Model.CurrentCategoryIndex" />
<div class="qab-response-layout">
<nav class="qab-tabs" aria-label="Questionnaire categories">
    @foreach (var category in Model.Questionnaire.Categories)
    {
        <a class="qab-tab @(category.Index == Model.CurrentCategoryIndex ? "is-current" : "")"
           href="?category=@category.Index" aria-current="@(category.Index == Model.CurrentCategoryIndex ? "step" : null)">
            <span>@category.Name</span><span class="qab-tab-number">@(category.Index + 1)</span>
        </a>
    }
</nav>
<div class="qab-response-content">
<p class="qab-progress">Category @(Model.CurrentCategoryIndex + 1) of @Model.Questionnaire.Categories.Count</p>
@{
    var categoryModel = Model.Questionnaire.Categories[Model.CurrentCategoryIndex];
    var renderedQuestionIds = categoryModel.Elements.Where(e => e.Question is not null).Select(e => e.Question!.Id).ToHashSet();
}
@foreach (var answer in Model.Response.Answers.Where(a => !renderedQuestionIds.Contains(a.Key)))
{
    if (answer.Value.Text is not null) { <input type="hidden" name="Answers[@answer.Key].Text" value="@answer.Value.Text" /> }
    if (answer.Value.Number is not null) { <input type="hidden" name="Answers[@answer.Key].Number" value="@answer.Value.Number.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" /> }
    foreach (var optionId in answer.Value.SelectedOptionIds ?? Array.Empty<int>()) { <input type="hidden" name="Answers[@answer.Key].SelectedOptionIds" value="@optionId" /> }
}
@await Html.PartialAsync("_Category", categoryModel)
<div class="qab-action-bar">
    @if (Model.CurrentCategoryIndex > 0)
    {
        <button class="qab-button qab-button-secondary" type="submit" name="TargetCategoryIndex" value="@(Model.CurrentCategoryIndex - 1)" data-qab-action="back">Back</button>
    }
    @if (Model.CurrentCategoryIndex < Model.Questionnaire.Categories.Count - 1)
    {
        <button class="qab-button qab-button-primary" type="submit" name="TargetCategoryIndex" value="@(Model.CurrentCategoryIndex + 1)" data-qab-action="continue">Save &amp; Continue</button>
    }
    else
    {
        <button class="qab-button qab-button-primary" type="submit" name="Intent" value="Review" data-qab-action="review">Review your answers</button>
    }
</div>
</div>
</div>
