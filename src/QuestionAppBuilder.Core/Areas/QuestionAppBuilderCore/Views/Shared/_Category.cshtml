@model RenderCategory
<section class="qab-category" aria-labelledby="category-title">
    <h2 id="category-title">@Model.Name</h2>
    @foreach (var element in Model.Elements)
    {
        if (element.Question is null) { <div class="qab-content-panel">@element.Label</div> }
        else if (element.FollowUpDepth > 0)
        {
            <div class="qab-follow-up" style="--branch-depth: @Math.Min(element.FollowUpDepth, 3)" role="group" aria-label="Follow-up: @element.FollowUpContext">
                <p class="qab-follow-up-context">Follow-up: @element.FollowUpContext</p>
                @await Html.PartialAsync("~/Areas/QuestionAppBuilderCore/Views/Shared/_Question.cshtml", element.Question)
            </div>
        }
        else { @await Html.PartialAsync("~/Areas/QuestionAppBuilderCore/Views/Shared/_Question.cshtml", element.Question) }
    }
</section>
