@model IReadOnlyList<QuestionAppBuilder.Application.Composition.CalculatedValue>
@if (Model.Count > 0)
{
    <dl class="qab-calculations" aria-label="Calculated results" aria-live="polite">
    @foreach (var value in Model)
    {
        <div><dt>@value.Name</dt><dd>@(value.Value?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "—")@(value.Value is not null && value.Percentage ? "%" : "")</dd></div>
    }
    </dl>
}
