@using QuestionAppBuilder.Domain.Entities
@using QuestionAppBuilder.Domain.Enums
@using QuestionAppBuilder.Domain.Graphs
@model (ApplicationDetailViewModel Detail, Element Element)
@{
    var element = Model.Element;
    var displayNumber = ViewData["ElementNumber"] as string;
    var graphElements = (Model.Detail.DraftGraph ?? Model.Detail.PublishedGraph)?.Categories.SelectMany(c => c.Elements).ToArray() ?? Array.Empty<Element>();
    var parent = FollowUpStructure.Parent(element, graphElements);
    var branchCount = FollowUpStructure.Branch(element, graphElements).Count - 1;
    var depth = FollowUpStructure.Depth(element, graphElements);
    var editable = Model.Detail.IsEditable;
    var itemKind = element.Question is null ? "content" : "question";
    var applicationId = Model.Detail.Application.Id;
    var revisionValue = Model.Detail.DraftGraph is null ? string.Empty : Convert.ToBase64String(Model.Detail.DraftGraph.Version.RevisionNonce.ToByteArray());
}

<style>
    .cv-content-el { padding: 16px 0; border-bottom: 1px solid #E4E8EC; }
    .cv-content-head { display: flex; align-items: flex-start; gap: 12px; min-width: 0; flex-wrap: wrap; }
    .cv-content-head h3 { flex: 1 1 12rem; min-width: 0; max-width: 100%; overflow-wrap: anywhere; font-size: 15px; font-weight: 700; line-height: 1.4; margin: 0; }
    .cv-content-el p { font-size: 14px; color: #565C65; margin-top: 4px; }
    .cv-q { padding: 18px 0; border-bottom: 1px solid #E4E8EC; }
    .cv-qhead { display: flex; align-items: flex-start; gap: 12px; min-width: 0; flex-wrap: wrap; }
    .cv-qhead h3 { flex: 1 1 12rem; min-width: 0; max-width: 100%; overflow-wrap: anywhere; font-size: 15.5px; font-weight: 700; line-height: 1.4; margin: 0; }
    .cv-req { font-size: 12px; font-weight: 600; color: #B50909; padding-top: 2px; }
    .cv-qmeta { font-size: 12.5px; color: #565C65; margin-top: 3px; }
    .cv-help { font-size: 14px; color: #565C65; margin-top: 4px; }
    .cv-link { font-family: inherit; background: none; border: 0; color: #005EA2; font-size: 13.5px; font-weight: 600; text-decoration: underline; text-underline-offset: 2px; cursor: pointer; text-align: left; padding: 0; }
    .cv-link:focus-visible { outline: 3px solid #2491FF; outline-offset: 1px; }
    .cv-el-remove { margin-left: 0; padding-top: 2px; white-space: nowrap; flex: 0 0 auto; }
</style>

@if (element.Kind == ElementKind.Content)
{
    <div class="cv-content-el" id="manage-element-@element.Id">
        <div class="cv-content-head">
            <h3><span class="cv-element-number">@displayNumber</span><span>@element.Label</span></h3>
            @if (editable)
            {
                <div class="cv-row-actions" role="group" aria-label="Actions for @element.Label">
                    <a class="qab-icon-action" asp-controller="Drafts" asp-action="Index" asp-route-applicationId="@applicationId" asp-fragment="element-@element.Id" aria-label="Edit @itemKind: @element.Label" title="Edit @itemKind: @element.Label"><partial name="_ActionIcon" model='@("edit")' /></a>
                    <form method="post" asp-controller="Elements" asp-action="Remove" asp-route-id="@element.Id" class="cv-el-remove" data-confirm="@(branchCount > 0 ? $"Remove this question and its {branchCount} follow-up question(s)?" : null)">
                        <input type="hidden" name="applicationId" value="@applicationId" />
                        <input type="hidden" name="expectedRevision" value="@revisionValue" />
                        <button type="submit" class="qab-icon-action qab-icon-danger" aria-label="Remove @itemKind: @element.Label" title="Remove @itemKind: @element.Label"><partial name="_ActionIcon" model='@("remove")' /></button>
                    </form>
                </div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(element.HelpText))
        {
            <p>@element.HelpText</p>
        }
    </div>
}
else if (element.Question is not null)
{
    <div class="cv-q @(parent is null ? "" : "cv-follow-up")" style="--branch-depth: @Math.Min(depth, 3)" id="manage-element-@element.Id">
        @if (parent is not null) { <p class="cv-help">Shows when: <strong>@parent.Label / @parent.Question!.Options.Single(o => o.Id == element.ParentOptionId).Label</strong> is selected.</p> }
        <div class="cv-qhead">
            <h3><span class="cv-element-number">@displayNumber</span><span>@element.Label</span></h3>
            @if (element.Question.IsRequired)
            {
                <span class="cv-req">Required</span>
            }
            @if (editable)
            {
                <div class="cv-row-actions" role="group" aria-label="Actions for @element.Label">
                    <a class="qab-icon-action" asp-controller="Drafts" asp-action="Index" asp-route-applicationId="@applicationId" asp-fragment="element-@element.Id" aria-label="Edit @itemKind: @element.Label" title="Edit @itemKind: @element.Label"><partial name="_ActionIcon" model='@("edit")' /></a>
                    <form method="post" asp-controller="Elements" asp-action="Remove" asp-route-id="@element.Id" class="cv-el-remove" data-confirm="@(branchCount > 0 ? $"Remove this question and its {branchCount} follow-up question(s)?" : null)">
                        <input type="hidden" name="applicationId" value="@applicationId" />
                        <input type="hidden" name="expectedRevision" value="@revisionValue" />
                        <button type="submit" class="qab-icon-action qab-icon-danger" aria-label="Remove @itemKind: @element.Label" title="Remove @itemKind: @element.Label"><partial name="_ActionIcon" model='@("remove")' /></button>
                    </form>
                </div>
            }
        </div>
        <div class="cv-qmeta">@QuestionFormViewModel.SplitPascalCase(element.Question.AnswerType.ToString())</div>
        @if (!string.IsNullOrWhiteSpace(element.HelpText))
        {
            <p class="cv-help">@element.HelpText</p>
        }
        <partial name="_QuestionPanel" model="(Detail: Model.Detail, Question: element.Question)" />
    </div>
}
