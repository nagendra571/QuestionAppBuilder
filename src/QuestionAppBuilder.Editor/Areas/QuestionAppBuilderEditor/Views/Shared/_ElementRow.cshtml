@using QuestionAppBuilder.Domain.Entities
@using QuestionAppBuilder.Domain.Enums
@model (ApplicationDetailViewModel Detail, Element Element)
@{
    var element = Model.Element;
    var editable = Model.Detail.IsEditable;
    var applicationId = Model.Detail.Application.Id;
}

<style>
    .cv-content-el { padding: 16px 0; border-bottom: 1px solid #E4E8EC; }
    .cv-content-head { display: flex; align-items: flex-start; gap: 12px; }
    .cv-content-head h3 { flex: 1; font-size: 15px; font-weight: 700; line-height: 1.4; margin: 0; }
    .cv-content-el p { font-size: 14px; color: #565C65; margin-top: 4px; }
    .cv-q { padding: 18px 0; border-bottom: 1px solid #E4E8EC; }
    .cv-qhead { display: flex; align-items: flex-start; gap: 12px; }
    .cv-qhead h3 { flex: 1; font-size: 15.5px; font-weight: 700; line-height: 1.4; margin: 0; }
    .cv-req { font-size: 12px; font-weight: 600; color: #B50909; padding-top: 2px; }
    .cv-qmeta { font-size: 12.5px; color: #565C65; margin-top: 3px; }
    .cv-help { font-size: 14px; color: #565C65; margin-top: 4px; }
    .cv-link { font-family: inherit; background: none; border: 0; color: #005EA2; font-size: 13.5px; font-weight: 600; text-decoration: underline; text-underline-offset: 2px; cursor: pointer; text-align: left; padding: 0; }
    .cv-link:focus-visible { outline: 3px solid #2491FF; outline-offset: 1px; }
    .cv-el-remove { margin-left: 8px; padding-top: 2px; white-space: nowrap; }
</style>

@if (element.Kind == ElementKind.Content)
{
    <div class="cv-content-el">
        <div class="cv-content-head">
            <h3>@element.Label</h3>
            @if (editable)
            {
                <form method="post" asp-controller="Elements" asp-action="Remove" asp-route-id="@element.Id" class="cv-el-remove">
                    <input type="hidden" name="applicationId" value="@applicationId" />
                    <button type="submit" class="cv-link">Remove</button>
                </form>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(element.HelpText))
        {
            <p>@element.HelpText</p>
        }
    </div>
}
else if (element.Question is not null)
{
    <div class="cv-q">
        <div class="cv-qhead">
            <h3>@element.Label</h3>
            @if (element.Question.IsRequired)
            {
                <span class="cv-req">Required</span>
            }
            @if (editable)
            {
                <form method="post" asp-controller="Elements" asp-action="Remove" asp-route-id="@element.Id" class="cv-el-remove">
                    <input type="hidden" name="applicationId" value="@applicationId" />
                    <button type="submit" class="cv-link">Remove</button>
                </form>
            }
        </div>
        <div class="cv-qmeta">@QuestionFormViewModel.SplitPascalCase(element.Question.AnswerType.ToString())</div>
        @if (!string.IsNullOrWhiteSpace(element.HelpText))
        {
            <p class="cv-help">@element.HelpText</p>
        }
        <partial name="_QuestionPanel" model="(Detail: Model.Detail, Question: element.Question)" />
    </div>
}
