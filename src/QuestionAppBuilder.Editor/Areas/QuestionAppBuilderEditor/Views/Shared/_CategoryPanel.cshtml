@using QuestionAppBuilder.Domain.Entities
@using QuestionAppBuilder.Domain.Enums
@model (ApplicationDetailViewModel Detail, Category Category)
@{
    var category = Model.Category;
    var editable = Model.Detail.IsEditable;
    var applicationId = Model.Detail.Application.Id;
    var revisionValue = Model.Detail.DraftGraph is null ? string.Empty : Convert.ToBase64String(Model.Detail.DraftGraph.Version.RevisionNonce.ToByteArray());
    var elements = category.Elements.OrderBy(element => element.SortOrder).ThenBy(element => element.Id).ToArray();
    var categoryNumber = (int?)ViewData["CategoryNumber"] ?? 1;
    var questionCount = elements.Count(element => element.Question is not null);
    var contentCount = elements.Count(element => element.Kind == ElementKind.Content);
}

<style>
    .cv-add { display: flex; gap: 10px; padding-top: 18px; flex-wrap: wrap; min-width: 0; }
    .cv-add-form { position: relative; min-width: 0; }
    .cv-add-form > summary { list-style: none; display: inline-block; }
    .cv-add-form > summary::-webkit-details-marker { display: none; }
    .cv-add-form form { position: absolute; left: 0; top: calc(100% + 8px); z-index: 20; width: 360px; background: #fff; border: 1px solid #D5DAE0; border-radius: 6px; padding: 16px; }
    .cv-add-form select, .cv-add-form textarea { width: 100%; padding: 8px 10px; border: 1px solid #565C65; border-radius: 4px; font: inherit; color: #1B1B1B; background: #fff; }
    .cv-add-form textarea { min-height: 4.5rem; resize: vertical; }
    .cv-add-form select:focus-visible, .cv-add-form textarea:focus-visible { outline: 3px solid #2491FF; outline-offset: 1px; }
    @@media (max-width:760px) {
        .cv-add { position: relative; }
        .cv-add-form { position: static; }
        .cv-add-form form { left: 0; right: auto; box-sizing: border-box; width: min(360px,calc(100vw - 32px)); }
    }
</style>

<section class="cv-card cv-category" id="manage-category-@category.Id" data-category-panel>
    <header class="cv-chead">
        <div class="cv-chead-title">
            <h2>@category.Name</h2><span class="cv-item-count">@questionCount @(questionCount == 1 ? "question" : "questions") @if (contentCount > 0) { <text>&middot; @contentCount @(contentCount == 1 ? "content block" : "content blocks")</text> }</span>
        </div>
        @if (editable)
        {
            <div class="cv-cact">
                <a class="qab-icon-action" aria-label="Edit category: @category.Name" title="Edit category: @category.Name" asp-controller="Drafts" asp-action="Index" asp-route-applicationId="@applicationId" asp-fragment="category-@category.Id"><partial name="_ActionIcon" model='@("edit")' /></a>
                <details class="cv-rename" id="rename-category-@category.Id">
                    <summary class="cv-btn-ghost">Rename</summary>
                    <form method="post" asp-controller="Categories" asp-action="Update" asp-route-id="@category.Id" class="cv-rename-form">
                <partial name="_ClosePanel" model='@("category rename form")' />
                        <input type="hidden" name="applicationId" value="@applicationId" />
                        <input type="hidden" name="expectedRevision" value="@revisionValue" />
                        <div class="cv-field">
                            <label for="category-name-@category.Id">Name</label>
                            <input id="category-name-@category.Id" name="Name" type="text" value="@category.Name" maxlength="200" />
                        </div>
                        <button type="submit" class="cv-btn">Save</button>
                    </form>
                </details>
                <a class="qab-icon-action qab-icon-danger cv-danger" aria-label="Remove category: @category.Name" title="Remove category: @category.Name"
                   asp-controller="Deletions" asp-action="Preview" asp-route-applicationId="@applicationId" asp-route-kind="Category" asp-route-targetId="@category.Id" asp-route-expectedRevision="@revisionValue"><partial name="_ActionIcon" model='@("remove")' /></a>
            </div>
        }
    </header>
    <div class="cv-cbody cv-elements">
        @for (var elementIndex = 0; elementIndex < elements.Length; elementIndex++)
        {
            var elementViewData = new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["ElementNumber"] = $"{categoryNumber}.{elementIndex + 1}" };
            <partial name="_ElementRow" model="(Detail: Model.Detail, Element: elements[elementIndex])" view-data="elementViewData" />
        }
        @if (editable)
        {
            <div class="cv-add">
                <details class="cv-add-form" id="add-question-@category.Id">
                    <summary class="cv-btn-ghost">Add question</summary>
                    <form method="post" asp-controller="Elements" asp-action="AddQuestion" asp-route-id="@category.Id">
                <partial name="_ClosePanel" model='@("question form")' />
                        <input type="hidden" name="applicationId" value="@applicationId" />
                        <input type="hidden" name="expectedRevision" value="@revisionValue" />
                        <div class="cv-field">
                            <label for="question-label-@category.Id">Question</label>
                            <input id="question-label-@category.Id" name="Label" type="text" maxlength="500" />
                        </div>
                        <div class="cv-field">
                            <label for="question-type-@category.Id">Answer type</label>
                            <select id="question-type-@category.Id" name="AnswerType">
                                @foreach (var answerType in Enum.GetValues<AnswerType>())
                                {
                                    <option value="@answerType">@QuestionFormViewModel.SplitPascalCase(answerType.ToString())</option>
                                }
                            </select>
                        </div>
                        <div class="cv-field cv-field-inline">
                            <input id="question-required-@category.Id" name="IsRequired" type="checkbox" value="true" checked="checked" />
                            <input type="hidden" name="IsRequired" value="false" />
                            <label for="question-required-@category.Id">Required</label>
                        </div>
                        <div class="cv-field">
                            <label for="question-help-@category.Id">Help text (optional)</label>
                            <textarea id="question-help-@category.Id" name="HelpText" maxlength="2000"></textarea>
                        </div>
                        <button type="submit" class="cv-btn">Add question</button>
                    </form>
                </details>
                <details class="cv-add-form" id="add-content-@category.Id">
                    <summary class="cv-btn-ghost">Add content</summary>
                    <form method="post" asp-controller="Elements" asp-action="AddContent" asp-route-id="@category.Id">
                <partial name="_ClosePanel" model='@("content form")' />
                        <input type="hidden" name="applicationId" value="@applicationId" />
                        <input type="hidden" name="expectedRevision" value="@revisionValue" />
                        <div class="cv-field">
                            <label for="content-label-@category.Id">Label</label>
                            <input id="content-label-@category.Id" name="Label" type="text" maxlength="500" />
                        </div>
                        <div class="cv-field">
                            <label for="content-help-@category.Id">Help text (optional)</label>
                            <textarea id="content-help-@category.Id" name="HelpText" maxlength="2000"></textarea>
                        </div>
                        <button type="submit" class="cv-btn">Add content</button>
                    </form>
                </details>
            </div>
        }
    </div>
</section>
