@model ApplicationDetailViewModel
@using System.Globalization
@using QuestionAppBuilder.Domain.Entities
@using QuestionAppBuilder.Domain.Enums
@{
    ViewData["Title"] = Model.Application.Name;
    var graph = Model.IsEditable ? Model.DraftGraph : Model.PublishedGraph;
    var revisionValue = Model.DraftGraph is null ? string.Empty : Convert.ToBase64String(Model.DraftGraph.Version.RevisionNonce.ToByteArray());
    var categories = graph?.Categories.OrderBy(category => category.SortOrder).ThenBy(category => category.Id).ToArray()
        ?? Array.Empty<Category>();
    var questionCount = categories.SelectMany(category => category.Elements).Count(element => element.Question is not null);
    var contentCount = categories.SelectMany(category => category.Elements).Count(element => element.Kind == ElementKind.Content);
    var publishedVersionNumber = Model.DraftGraph is not null && Model.Application.CurrentVersionId is not null
        ? Model.DraftGraph.Version.VersionNumber - 1
        : 0;
}

<style>
    .cv-back { font-size: 13.5px; color: #005EA2; font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
    .cv-back:focus-visible { outline: 3px solid #2491FF; outline-offset: 1px; }
    .cv-alert { margin-top: 14px; background: #fff; border: 1px solid #B50909; border-left: 6px solid #B50909; border-radius: 4px; color: #B50909; font-size: 14px; font-weight: 600; padding: 12px 16px; }
    .cv-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin: 14px 0 4px; }
    .cv-head h1 { min-width: 0; max-width: 100%; overflow-wrap: anywhere; font-size: 24px; font-weight: 700; line-height: 1.25; margin: 0; }
    .cv-statusline { margin-top: 8px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .cv-badge { font-size: 12.5px; font-weight: 700; padding: 4px 12px; border-radius: 4px; }
    .cv-draft { background: #E7EDF5; color: #1A4480; }
    .cv-published { background: #EAF3EB; color: #236B2C; }
    .cv-independent { background: #E7EDF5; color: #1A4480; }
    .cv-note { font-size: 13px; color: #565C65; }
    .cv-toolbar { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin: 16px 0 20px; }
    .cv-type { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; border: 1px solid #1A4480; color: #1A4480; border-radius: 4px; padding: 2px 8px; }
    .cv-updated { font-size: 13px; color: #565C65; }
    .cv-publish { margin-left: auto; }
    .cv-btn { font-family: inherit; font-size: 14px; font-weight: 700; background: #005EA2; color: #fff; border: 0; border-radius: 4px; padding: 10px 18px; cursor: pointer; }
    .cv-btn:hover { background: #1A4480; }
    .cv-btn:focus-visible { outline: 3px solid #2491FF; outline-offset: 1px; }
    .cv-btn-ghost { font-family: inherit; font-size: 13px; font-weight: 600; color: #005EA2; background: #fff; border: 1px solid #005EA2; border-radius: 4px; padding: 6px 12px; cursor: pointer; }
    .cv-btn-ghost:hover { background: #F1F4F7; }
    .cv-btn-ghost:focus-visible { outline: 3px solid #2491FF; outline-offset: 1px; }
    .cv-danger { color: #B50909; border-color: #B50909; }
    .cv-card { background: #fff; border: 1px solid #D5DAE0; border-radius: 6px; margin-bottom: 16px; }
    .cv-chead { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 16px; border-bottom: 1px solid #D5DAE0; }
    .cv-chead h2 { min-width: 0; max-width: 100%; overflow-wrap: anywhere; font-size: 18px; font-weight: 700; margin: 0; }
    .cv-chead-title { display: flex; align-items: center; gap: 12px; min-width: 0; max-width: 100%; flex: 1 1 12rem; }
    .cv-cact { display: flex; gap: 10px; align-items: flex-start; flex-wrap: wrap; min-width: 0; }
    .cv-cbody { padding: 8px 16px 16px; }
    .cv-readonly { padding: 16px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .cv-readonly p { margin: 0; color: #565C65; font-size: 14px; }
    .cv-field { margin-bottom: 12px; }
    .cv-award-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 12px; margin: 8px 0; padding: 8px 10px; border: 1px solid #d5dae0; border-radius: 4px; background: #f8f9fa; }
    .cv-award-details[hidden] { display: none; }
    .cv-award-details p { grid-column: 1 / -1; margin: 0 0 8px; }
    .cv-field[hidden] { display: none; }
    .cv-field label { display: block; font-size: 13.5px; font-weight: 600; margin-bottom: 4px; }
    .cv-field input[type="text"] { width: 100%; max-width: 24rem; padding: 8px 10px; border: 1px solid #565C65; border-radius: 4px; font: inherit; color: #1B1B1B; background: #fff; }
    .cv-field input[type="number"], .cv-field select { width: 100%; max-width: 24rem; padding: 8px 10px; border: 1px solid #565C65; border-radius: 4px; font: inherit; color: #1B1B1B; background: #fff; }
    .cv-field input[type="text"]:focus-visible { outline: 3px solid #2491FF; outline-offset: 1px; }
    .cv-field-inline { display: flex; align-items: center; gap: 8px; }
    .cv-field-inline label { display: inline; margin: 0; font-weight: 400; }
    .cv-btn { display:inline-flex; align-items:center; text-decoration:none; }
    .cv-rename { position: relative; }
    .cv-rename summary { list-style: none; display: inline-block; }
    .cv-rename summary::-webkit-details-marker { display: none; }
    .cv-rename { min-width: 0; }
    .cv-rename-form { position: absolute; right: 0; top: calc(100% + 8px); z-index: 10; width: 320px; background: #fff; border: 1px solid #D5DAE0; border-radius: 6px; padding: 16px; }
    @@media (max-width:760px) {
        .cv-head,.cv-chead { flex-wrap:wrap; gap:12px; }
        .cv-head > *, .cv-chead-title, .cv-cact { min-width:0; max-width:100%; }
        .cv-rename-form { left:0; right:auto; width:min(320px,calc(100vw - 48px)); }
        .cv-btn,.cv-btn-ghost { min-height:44px; }
    }
</style>

<link rel="stylesheet" href="~/_content/QuestionAppBuilder.Editor/css/authoring-detail.css" />
<link rel="stylesheet" href="~/_content/QuestionAppBuilder.Editor/css/editor-actions.css" />
<script src="~/_content/QuestionAppBuilder.Editor/js/editor-panels.js" defer></script>
<script src="~/_content/QuestionAppBuilder.Editor/js/authoring-context.js" defer></script>
<script src="~/_content/QuestionAppBuilder.Editor/js/authoring-detail.js" defer></script>
<script src="~/_content/QuestionAppBuilder.Editor/js/scoring-award-preview.js" defer></script>
<main class="cv-management" data-authoring-context>
<a class="cv-back" asp-controller="Applications" asp-action="Index">&#8592; All applications</a>

@if (TempData["EditorError"] is string editorError)
{
    <div class="cv-alert" role="alert">@editorError</div>
}

<div class="cv-head cv-compact-head">
    <div class="cv-app-identity">
        <h1>@Model.Application.Name</h1>
<div class="cv-statusline">
    @if (Model.IsEditable && Model.DraftGraph is not null)
    {
        <span class="cv-badge cv-draft">Draft version @Model.DraftGraph.Version.VersionNumber</span>
        @if (publishedVersionNumber >= 1)
        {
            <span class="cv-note">Published v@(publishedVersionNumber) exists &mdash; editing a draft copy</span>
        }
    }
    else if (Model.PublishedGraph is not null)
    {
        <span class="cv-badge cv-published">Published version @Model.PublishedGraph.Version.VersionNumber &mdash; read-only</span>
    }
    @if (!string.IsNullOrEmpty(Model.TypeName))
    {
        <span class="cv-type">@Model.TypeName</span>
    }
    <span class="cv-updated">Updated @Model.Application.UpdatedUtc.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</span>
</div>

    </div>
    @if (Model.IsEditable && Model.DraftGraph is not null)
    {
        <div class="cv-app-actions">
            <a class="cv-btn" asp-controller="Drafts" asp-action="Index" asp-route-applicationId="@Model.Application.Id">Open authoring workspace</a>
            <details class="cv-publish-panel" id="application-publishing">
                <summary class="cv-btn-ghost">Review &amp; publish</summary>
        <form method="post" asp-controller="Applications" asp-action="Publish" asp-route-id="@Model.Application.Id" class="cv-publish">
                <partial name="_ClosePanel" model='@("publishing")' />
            <input type="hidden" name="expectedRevision" value="@revisionValue" />
            @if (Model.DraftReview is not null)
            {
                foreach (var warning in Model.DraftReview.Warnings.DistinctBy(item => item.Code))
                {
                    <div class="cv-field cv-field-inline">
                        <input id="warning-@warning.Code" name="acknowledgedWarningCodes" type="checkbox" value="@warning.Code" />
                        <label for="warning-@warning.Code">Acknowledge: @warning.Message</label>
                    </div>
                }
            }
            <button type="submit" class="cv-btn">Publish version @Model.DraftGraph.Version.VersionNumber</button>
        </form>
            </details>
        </div>
    }
</div>

@if (Model.Application.CurrentVersionId is not null)
{
    <section class="cv-availability" aria-labelledby="availability-heading">
        <details id="respondent-availability">
        <summary><span id="availability-heading">Respondent availability</span><span class="cv-availability-status">New responses: @(Model.Application.AcceptNewResponses ? "Open" : "Closed") &middot; Submissions: @(Model.Application.AcceptSubmissions ? "Open" : "Closed")</span></summary>
        <div class="cv-cbody">
            <p>Control whether respondents can start new responses and submit saved responses. Existing drafts remain available when starts close.</p>
            <form method="post" asp-controller="Applications" asp-action="UpdateAvailability" asp-route-id="@Model.Application.Id">
                <partial name="_ClosePanel" model='@("respondent availability")' />
                <input type="hidden" name="expectedRevision" value="@Convert.ToBase64String(Model.Application.RowVersion)" />
                <div class="cv-field cv-field-inline">
                    <input id="accept-new-responses" name="acceptNewResponses" type="checkbox" value="true" checked="@Model.Application.AcceptNewResponses" />
                    <input type="hidden" name="acceptNewResponses" value="false" />
                    <label for="accept-new-responses">Accept new responses</label>
                </div>
                <div class="cv-field cv-field-inline">
                    <input id="accept-submissions" name="acceptSubmissions" type="checkbox" value="true" checked="@Model.Application.AcceptSubmissions" />
                    <input type="hidden" name="acceptSubmissions" value="false" />
                    <label for="accept-submissions">Accept submissions</label>
                </div>
                <button type="submit" class="cv-btn">Save availability</button>
            </form>
        </div>
        </details>
    </section>
}

@if (Model.DraftReview?.Errors.Count > 0)
{
    <div class="cv-alert" role="alert">
        @foreach (var issue in Model.DraftReview.Errors)
        {
            <div>@issue.Message</div>
        }
    </div>
}

@if (!Model.IsEditable)
{
    <section class="cv-card">
        <div class="cv-cbody cv-readonly">
            <p>This version is published and read-only. Start editing to work on a draft copy.</p>
            <form method="post" asp-controller="Applications" asp-action="StartDraft" asp-route-id="@Model.Application.Id">
                <button type="submit" class="cv-btn">Start editing</button>
            </form>
        </div>
    </section>
}

<p class="cv-questionnaire-summary"><strong>@questionCount @(questionCount == 1 ? "question" : "questions")</strong> across @categories.Length @(categories.Length == 1 ? "category" : "categories")<span class="cv-summary-content"> &middot; @contentCount @(contentCount == 1 ? "content block" : "content blocks")</span></p>
<nav class="cv-category-nav" aria-label="Application categories">
    @foreach (var category in categories) { <a href="#manage-category-@category.Id">@category.Name</a> }
    @if (Model.IsEditable)
    {
        <a class="cv-add-category-link" href="#manage-add-category"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg><span>Add category</span></a>
    }
</nav>
@for (var categoryIndex = 0; categoryIndex < categories.Length; categoryIndex++)
{
    var categoryViewData = new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["CategoryNumber"] = categoryIndex + 1 };
    <partial name="_CategoryPanel" model="(Detail: Model, Category: categories[categoryIndex])" view-data="categoryViewData" />
}

@if (Model.IsEditable)
{
    <section class="cv-card" id="manage-add-category" data-close-return="#manage-category-@categories.FirstOrDefault()?.Id">
        <header class="cv-chead">
            <h2>Add category</h2>
            @if (categories.Length > 0) { <partial name="_ClosePanel" model='@("category form")' /> }
        </header>
        <div class="cv-cbody">
            <form method="post" asp-controller="Categories" asp-action="Add">
                <input type="hidden" name="applicationId" value="@Model.Application.Id" />
                <input type="hidden" name="expectedRevision" value="@revisionValue" />
                <div class="cv-field">
                    <label for="new-category-name">Name</label>
                    <input id="new-category-name" name="Name" type="text" maxlength="200" />
                </div>
                <button type="submit" class="cv-btn">Add category</button>
            </form>
        </div>
    </section>
}
</main>
