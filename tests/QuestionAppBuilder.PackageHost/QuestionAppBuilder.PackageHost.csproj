<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="QuestionAppBuilder.Infrastructure" Version="$(PackageVersion)" />
    <PackageReference Include="QuestionAppBuilder.Core" Version="$(PackageVersion)" />
    <PackageReference Include="QuestionAppBuilder.Editor" Version="$(PackageVersion)" />
    <PackageReference Include="QuestionAppBuilder.Reports" Version="$(PackageVersion)" />
  </ItemGroup>
</Project>
