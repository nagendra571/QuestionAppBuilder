@inject IConfiguration Configuration
@{
    var editorBasePath = Configuration["QuestionAppBuilderEditor:BasePath"] ?? "/ConfigureApp";
    var runtimeBasePath = Configuration["QuestionAppBuilderRuntime:BasePath"] ?? "/App";
    var reportsBasePath = Configuration["QuestionAppBuilderReports:BasePath"] ?? "/Reports";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuestionAppBuilder</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --qab-navy: #1A4480;
            --qab-ground: #F1F4F7;
            --qab-panel: #FFFFFF;
            --qab-border: #D5DAE0;
            --qab-primary: #005EA2;
            --qab-focus: #2491FF;
            --qab-danger: #B50909;
            --qab-text: #1B1B1B;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-size:14px; line-height:1.5; font-family: "Public Sans", "Helvetica Neue", Arial, sans-serif; color: var(--qab-text); background: var(--qab-ground); }
        .qab-host-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; background: var(--qab-navy); color: #fff; padding: 0.75rem 1.5rem; }
        .qab-host-bar a { color: #fff; text-decoration: none; font-weight: 600; }
        .qab-host-nav { display: flex; gap: 1rem; margin-right: auto; margin-left: 1.5rem; }
        .qab-host-bar form { display: flex; align-items: center; gap: 0.75rem; margin: 0; }
        .qab-host-bar button { background: transparent; border: 1px solid #fff; }
        main { max-width: 1280px; margin: 0 auto; padding: 1.5rem; }
        h1 { font-size: 24px; font-weight: 700; margin: 0 0 1rem; }
        a { color: var(--qab-primary); }
        a:focus-visible, button:focus-visible, input:focus-visible { outline: 3px solid var(--qab-focus); outline-offset: 1px; }
        table { width: 100%; border-collapse: collapse; background: var(--qab-panel); border: 1px solid var(--qab-border); border-radius: 4px; }
        th, td { border-bottom: 1px solid var(--qab-border); padding: 0.6rem 0.75rem; text-align: left; }
        th { font-weight: 600; }
        button { background: var(--qab-primary); color: #fff; border: 0; border-radius: 4px; padding: 0.5rem 1rem; font: inherit; cursor: pointer; }
        .field { margin-bottom: 0.9rem; }
        label { display: block; font-weight: 600; margin-bottom: 0.3rem; }
        input[type="text"], input[type="password"] { width: 100%; max-width: 24rem; padding: 0.5rem; border: 1px solid var(--qab-border); border-radius: 4px; font: inherit; background: var(--qab-panel); }
        .validation-summary-errors { color: var(--qab-danger); }
        .validation-summary-errors ul { margin: 0.25rem 0 1rem; padding-left: 1.25rem; }
        @@media (max-width: 480px) {
            .qab-host-bar { flex-wrap: wrap; align-items: flex-start; padding: 0.75rem; }
            .qab-host-nav { flex: 1 0 100%; flex-wrap: wrap; margin: 0.5rem 0 0; gap: 0.5rem 0.75rem; }
            .qab-host-content main { padding: 1rem 0.75rem; }
        }
        .qab-host-bar { min-height:56px; padding:8px 24px; background:#183b65; }
        .qab-host-bar > a { font-size:15px; letter-spacing:-.3px; }
        .qab-host-nav { gap:4px; }
        .qab-host-nav a { padding:8px 12px; border-radius:4px; font-size:13px; }
        .qab-host-nav a:hover,.qab-host-nav a[aria-current="page"] { background:#31547b; }
        .qab-host-bar form { font-size:12px; }
        .qab-host-bar button { padding:6px 10px; border-color:#829ab6; }
        h2 { font-size:18px; }
        button:hover { filter:brightness(.94); }
        select,textarea { font:inherit; }
        @@media (max-width:760px) {
            .qab-host-bar { flex-wrap:wrap; padding:10px 16px; gap:8px; }
            .qab-host-nav { order:3; width:100%; margin:0; }
            .qab-host-bar form { margin-left:auto; }
            .qab-host-nav a { min-height:44px; display:flex; align-items:center; }
            input,select,textarea { font-size:16px; }
        }
    </style>
</head>
<body>
    <header class="qab-host-bar">
        <a href="/">QuestionAppBuilder</a>
        <nav aria-label="Platform surfaces" class="qab-host-nav">
            <a href="@(editorBasePath.TrimEnd('/') + "/Applications")" aria-current="@(Context.Request.Path.StartsWithSegments(editorBasePath) ? "page" : null)">Design</a>
            <a href="@(runtimeBasePath.TrimEnd('/') + "/Mine")" aria-current="@(Context.Request.Path.StartsWithSegments(runtimeBasePath) ? "page" : null)">My responses</a>
            <a href="@(reportsBasePath.TrimEnd('/') + "/")" aria-current="@(Context.Request.Path.StartsWithSegments(reportsBasePath) ? "page" : null)">Reports</a>
        </nav>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" action="/Account/Logout">
                @Html.AntiForgeryToken()
                <span>@User.Identity.Name</span>
                <button type="submit">Sign out</button>
            </form>
        }
    </header>
    <div class="qab-host-content">
        @RenderBody()
    </div>
</body>
</html>
