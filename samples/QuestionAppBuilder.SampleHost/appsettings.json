{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "QuestionAppBuilderEditor": {
    "BasePath": "/ConfigureApp",
    "DesignPolicy": "QuestionAppBuilder.Design"
  },
  "QuestionAppBuilderRuntime": {
    "BasePath": "/App",
    "PublicBaseUri": "https://localhost"
  },
  "QuestionAppBuilderReports": {
    "BasePath": "/Reports",
    "DisplayTimeZone": "UTC"
  },
  "QuestionAppBuilder": {
    "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=QuestionAppBuilderSampleHost;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "Authorization": {
      "DesignRole": "Designer",
      "ReportRole": "Analyst"
    }
  }
}
